# Local control is enabled automatically by `npm run dev`.
# Set these when using `npm start` against the local pipeline.
YT_AUTO_LOCAL_CONTROL=1
PIPELINE_ROOT=.

# Safe GitHub routing values used by the deployed queue editor.
YT_AUTO_GITHUB_REPOSITORY=Rendyprobe/YT-Auto
YT_AUTO_GITHUB_BRANCH=main

# Never commit YT_AUTO_GITHUB_TOKEN. Store it as a secret environment variable.
