{
  "name": "yt-auto-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "bundle:sites": "npx --yes node@22 node_modules/wrangler/bin/wrangler.js deploy --dry-run --outdir .sites-worker && cp .sites-worker/worker.js .open-next/worker.js",
    "build:sites": "npm run build:cloudflare && npm run bundle:sites",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "15.5.22",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "glob": "13.0.6",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
